# Postgres URL (Neon pooled connection string). Empty = local PGlite in .data/pglite
DATABASE_URL=
APP_URL=http://localhost:3000
APP_NAME=Multi-Shop POS
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
# Product photos: private Supabase Storage bucket "product-images". Empty = photos are stored in .data/images
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# MFA: base64 of 32 random bytes (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Required in production.
MFA_SECRET_KEY=
