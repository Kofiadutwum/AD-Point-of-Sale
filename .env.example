# Postgres URL (Neon pooled connection string). Empty = local PGlite in .data/pglite
DATABASE_URL=
APP_URL=http://localhost:3000
APP_NAME=Multi-Shop POS
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
# Product photos: private Cloudflare R2 bucket (R2 API token with Object Read & Write on that bucket only). Empty = photos are stored in .data/images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=product-images
# MFA: base64 of 32 random bytes (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Required in production.
MFA_SECRET_KEY=
# Cron: a scheduler calls GET /api/cron/notifications every 15 minutes with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# SMS (Arkesel). Empty = SMS printed to the console.
SMS_API_KEY=
SMS_SENDER_ID=
# Paystack (the platform's own account, subscriptions only). Webhook URL: $APP_URL/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Where "Report this page" on storefronts sends email.
REPORT_EMAIL=
